# Keep real values outside Git and the miniprogram package. run.sh reads exported variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=55
# DeepSeek ASR uses the same DEEPSEEK_API_KEY. Disable without removing the key if needed.
AI_ASR_ENABLED=true
AI_ASR_TIMEOUT_SECONDS=30
PORT=8080

# Optional separate vision provider for meal photos. Example: Volcengine Ark / Doubao.
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_MODEL=doubao-seed-2-1-lite-260915
# VISION_THINKING=disabled
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_THINKING=
SERVER_ADDRESS=127.0.0.1

# Real WeChat sessions require all three values. Never expose APP_SECRET to client.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SESSION_SIGNING_SECRET=
USER_IDENTITY_SECRET=

# Local simulator only: export SPRING_PROFILES_ACTIVE=local and generate your own >=24-char token.
# The service must remain loopback-bound. Never expose local profile through a public reverse proxy.
SPRING_PROFILES_ACTIVE=
BACKEND_DEV_TOKEN=

# Operations: local file mode or CloudBase PostgreSQL (required for container deployment).
OPS_STORAGE=file
OPS_DATA_DIR=./data/ops
OPS_ADMIN_TOKEN=
CLOUDBASE_ENV_ID=
# Server API key only. Never put into Mini Program or web bundles.
CLOUDBASE_SERVER_API_KEY=

# WeChat CloudRun MySQL (private networking), selected with OPS_STORAGE=mysql
OPS_MYSQL_URL=
OPS_MYSQL_USER=
OPS_MYSQL_PASSWORD=

# Private COS objects. Enable only after bucket and server credentials are configured.
COS_ENABLED=false
COS_BUCKET=
COS_REGION=ap-shanghai
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
